# OpenAI Responses API。复制为 .env 后填入密钥；密钥只由本地 API 读取。
OPENAI_API_KEY=
WEIXIN_LLM_MODEL=gpt-5.6
WEIXIN_LLM_REASONING=medium
WEIXIN_LLM_CONTEXT_LIMIT=120

# 也可指向支持 Responses API 的本机兼容服务。
# WEIXIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# WEIXIN_LLM_PROVIDER=本地模型

# 默认会读取 ~/Documents/LLMApiKey.rtf。若要改用其他文件，请填写绝对路径；设为 disabled 可停用文件加载。
# WEIXIN_LLM_KEY_FILE=/absolute/path/to/LLMApiKey.rtf

# 实时只读模式：密钥文件必须为 600，current 是同步器原子切换的快照链接。
# WEIXIN_DECRYPTED_DIR=/absolute/path/to/.local/wechat-live/current
# WEIXIN_LIVE_SOURCE=/absolute/path/to/xwechat_files/account/db_storage
# WEIXIN_LIVE_ROOT=/absolute/path/to/.local/wechat-live
# WEIXIN_LIVE_KEYS=/absolute/path/to/.local/wechat-live/keys.json
# WEIXIN_LIVE_STATUS=/absolute/path/to/.local/wechat-live/status.json
# WEIXIN_LIVE_RETRY_MS=30000

# 本机微信语音转文字。微信语音通常为 SILK，Python 环境还需要安装 silk-python。
# WEIXIN_WHISPER_PATH=/absolute/path/to/whisper
# WEIXIN_WHISPER_PYTHON=/absolute/path/to/python
# WEIXIN_WHISPER_MODEL=small
# WEIXIN_WHISPER_LANGUAGE=zh
# WEIXIN_WHISPER_BEAM_SIZE=5
# 可选：为人名、产品名或行业术语提供一小段上下文，不要写成长指令。
# WEIXIN_WHISPER_INITIAL_PROMPT=微信聊天，OpenAI，AgentOS
# WEIXIN_VOICE_TRANSCRIPT_DIR=/absolute/path/to/local-cache
