<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.weixin-agentos</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>local/dev.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIRECTORY__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIRECTORY__/.local/logs/agentos.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIRECTORY__/.local/logs/agentos.error.log</string>
</dict>
</plist>
